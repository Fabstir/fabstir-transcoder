PORTAL_URL=
PORTAL_ENCRYPT_URL=
TOKEN=
PATH_TO_FILE=
PATH_TO_TRANSCODED_FILE=
MEDIA_FORMATS_FILE=
FILE_SIZE_THRESHOLD=
TRANSCODED_FILE_SIZE_THRESHOLD=
GARBAGE_COLLECTOR_INTERVAL=3600
MAX_CONCURRENT_TRANSCODES=3
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
IPFS_GATEWAY=
FABSTIR_TRANSCODER_JWT=
FABSTIR_TRANSCODER_SECRET_KEY=
NVIDIA_DRIVER_CAPABILITIES=
# Content-moderation publish gate: off | dark | enforce (default off).
# Any other value stops the server at startup. dark records verdicts but still
# publishes; enforce publishes only on a cleared verdict. Independent of
# MODERATION_ENABLED below. See docs/API.md.
MODERATION_GATE=off
# Required once the gate is dark or enforce:
# MODERATION_NODE_URL=
# MODERATION_INGEST_TOKEN=
MODERATION_FRAMES_TIMEOUT_SECS=30
MODERATION_SAMPLE_INTERVAL_SECS=2.0
MODERATION_MAX_INTERVAL_SECS=12.0
MODERATION_KEYFRAME_MAX=1000

# Shadow scan by the moderation sidecar. Never blocks a job; needs the sidecar.
MODERATION_ENABLED=false
# Required when MODERATION_ENABLED=true:
# MODERATION_SOCKET_PATH=
MODERATION_SIDECAR_SOURCE_ROOT=/sources
MODERATION_TIMEOUT_SECS=10800
MODERATION_MAX_PENDING=8
